{
  "entities": {
    "AdRequest": {
      "title": "AdRequest",
      "description": "Advertisement and contact inquiry sent by a site visitor exclusively to the developer.",
      "type": "object",
      "properties": {
        "senderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Sender or advertiser name"
        },
        "contactInfo": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120,
          "description": "Telegram handle or email address for reply"
        },
        "adTitle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Proposed advertisement or message subject"
        },
        "adLink": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Optional target URL for the advertisement"
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1500,
          "description": "Full inquiry or ad details"
        },
        "placement": {
          "type": "string",
          "enum": ["slot1", "slot2", "both"],
          "description": "Preferred ad slot placement on Sakina"
        },
        "status": {
          "type": "string",
          "enum": ["new", "read", "published", "archived"],
          "description": "Moderation state controlled exclusively by the developer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of submission"
        }
      },
      "required": [
        "senderName",
        "contactInfo",
        "adTitle",
        "message",
        "placement",
        "status",
        "createdAt"
      ]
    },
    "PublishedAd": {
      "title": "PublishedAd",
      "description": "Active advertisement banner approved and published by the developer.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Short headline for the ad banner"
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "description": "Concise ad copy"
        },
        "ctaText": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "Button call-to-action label"
        },
        "targetUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 300,
          "description": "Destination HTTPS/HTTP URL when clicked"
        },
        "slotNumber": {
          "type": "number",
          "enum": [1, 2],
          "description": "Target AdSlot position (1 or 2)"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the ad is currently displayed publicly"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": [
        "title",
        "description",
        "ctaText",
        "targetUrl",
        "slotNumber",
        "active",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/ad_requests/{requestId}": {
      "schema": { "$ref": "#/entities/AdRequest" },
      "description": "Private inbox of advertiser/visitor messages readable and manageable only by the developer."
    },
    "/published_ads/{adId}": {
      "schema": { "$ref": "#/entities/PublishedAd" },
      "description": "Publicly displayed sponsored ads managed exclusively by the developer."
    }
  }
}
